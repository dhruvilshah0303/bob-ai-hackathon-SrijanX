# Copy this file to ".env" (or "local.env" - both are read, see env_loader.py)
# in the same folder and fill in ONE of the keys below to get real
# traffic-aware ETA. If neither is set, the app automatically uses a
# clearly-labeled simulated ETA instead - the demo works either way.

GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=

# AI Triage Assist + AI hospital handover notes (backend/triage_service.py),
# both powered by the same IBM watsonx.ai Granite model: the first
# classifies a dispatcher's free-text note (e.g. "55yo male, crushing chest
# pain radiating to left arm") into a suggested condition code; the second
# drafts the natural-language handover sentence sent with the hospital
# pre-alert. Same "the demo works either way" story as the two keys above:
# if either of these is blank, both features automatically fall back to a
# transparent, non-AI path (a labeled keyword classifier / a deterministic
# template) instead of a live model call.
#
# WATSONX_API_KEY is an IBM Cloud API key (IBM Cloud console -> Manage ->
# Access (IAM) -> API keys). WATSONX_PROJECT_ID is the watsonx.ai project
# this key should call into (watsonx.ai -> your project -> Manage ->
# General -> Project ID).
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Region-specific watsonx.ai endpoint your project lives in (see the
# project's "Manage" page) - us-south is the default and most common.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Which watsonx.ai foundation-model-catalog Granite model to call. The
# catalog changes over time, so this is overridable rather than hardcoded -
# check watsonx.ai's model catalog for the current Granite instruct model
# id if this default 404s.
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------------------
# Production / deployment settings (all optional - safe defaults for local
# dev). See PRODUCTION_READINESS_RECOMMENDATIONS.md for the full write-up.
# ---------------------------------------------------------------------------

# "development" (default) or "production". Only changes startup warnings
# right now (e.g. nags you if you deploy with an auto-generated JWT_SECRET or
# open CORS) - it does not disable anything by itself.
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API/WebSocket from a
# browser, e.g. "https://my-demo.example.com,https://staging.example.com".
# Defaults to "*" (any origin) which is fine for local dev but should be
# locked down for a real deployment.
ALLOWED_ORIGINS=*

# Signs every JWT session token (see auth_service.py). Leave blank for local
# dev - a random secret is generated per-process automatically, which is
# fine until you restart (every existing login session is invalidated on
# every restart, since the old secret is gone). For a real deployment, set
# this to a long random string that stays FIXED across restarts/redeploys -
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# SQLAlchemy connection string. Leave blank to use a local SQLite file
# (coordinator.db) - fine for a demo. Set to a Postgres URL for a real
# deployment (Render/Railway/Heroku-style "postgres://..." URLs are accepted
# and normalized automatically), e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Simple per-IP request cap on /api/* routes, reset every minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Only set this to "true" if you KNOW this app sits behind a reverse proxy
# / load balancer you control that overwrites the "X-Forwarded-For" header
# itself. Leave "false" (the default) whenever the app is directly reachable
# by untrusted clients - otherwise anyone can spoof this header to dodge the
# rate limit or frame another IP address.
TRUST_PROXY_HEADERS=false

# uvicorn ALSO has its own, separate X-Forwarded-For trust mechanism
# (independent of TRUST_PROXY_HEADERS above), controlled by this env var -
# it defaults to trusting 127.0.0.1, which matters if something proxies to
# uvicorn from the same machine (e.g. nginx on the same host). The Docker
# image sets this to "" (trust nothing) by default.
# IMPORTANT: unlike every other setting in this file, uvicorn reads this
# BEFORE this app (and its .env/local.env loading) is even imported, so
# putting it in .env/local.env has NO EFFECT - it must be set as a real
# process/shell/platform environment variable (or left as the Dockerfile's
# ENV default). Listed here only for documentation.
# FORWARDED_ALLOW_IPS=

# Optional error tracking - https://sentry.io. Leave blank to disable
# entirely (no sentry-sdk calls are made unless this is set).
SENTRY_DSN=

# Python logging level for the app's own logger.
LOG_LEVEL=INFO
